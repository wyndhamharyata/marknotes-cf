---
export const prerender = false;

import BaseAdminLayout from "../../layouts/BaseAdminLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, ADMIN_DOCK } from "../../consts";
import HomeModerationAlert from "./_components/HomeModerationAlert.astro";
import HomeKpiStrip from "./_components/HomeKpiStrip.astro";
import HomeTrendChart from "./_components/HomeTrendChart.astro";
import HomeRecentComments from "./_components/HomeRecentComments.astro";
import HomeTopArticles from "./_components/HomeTopArticles.astro";
---

<BaseAdminLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  dockProp={{ menus: ADMIN_DOCK, currentPath: "/admin" }}
>
  <!-- Each island in its own wrapper: see the note in BlogPost.astro. -->
  <div class="contents"><HomeModerationAlert server:defer /></div>

  <div class="contents">
    <HomeKpiStrip server:defer>
      <div slot="fallback" class="till readouts"><div class="vfd"></div></div>
    </HomeKpiStrip>
  </div>

  <div class="grid grid-cols-1 gap-x-10 lg:grid-cols-[minmax(0,1fr)_440px]">
    <div>
      <section class="plot">
        <h2>Pageviews — last 30 days</h2>
        <div class="contents">
          <HomeTrendChart server:defer>
            <div slot="fallback" class="min-h-[280px]"></div>
          </HomeTrendChart>
        </div>
      </section>
      <div class="contents"><HomeTopArticles server:defer /></div>
    </div>

    <section class="comments" style="width:100%;margin:0">
      <div class="contents"><HomeRecentComments server:defer /></div>
    </section>
  </div>
</BaseAdminLayout>
