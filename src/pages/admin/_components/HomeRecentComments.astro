---
import { getCollection } from "astro:content";
import { getDoStub } from "../../../lib/db/do-client";
import { getModerationStampClass, getModerationLabel } from "../../../lib/comments/types";
import Avatar from "../../articles/_components/comments/Avatar";

const [{ comments, total }, articles] = await Promise.all([
  getDoStub().getCommentsForAdmin({ status: null, limit: 5, page: 1 }),
  getCollection("blog"),
]);

const titleMap = new Map(articles.map((a) => [a.id, a.data.title]));

const relTime = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
function formatRelative(date: Date): string {
  const diffSec = Math.round((date.getTime() - Date.now()) / 1000);
  const abs = Math.abs(diffSec);
  if (abs < 60) return relTime.format(diffSec, "second");
  if (abs < 3600) return relTime.format(Math.round(diffSec / 60), "minute");
  if (abs < 86400) return relTime.format(Math.round(diffSec / 3600), "hour");
  return relTime.format(Math.round(diffSec / 86400), "day");
}

function truncate(s: string, n: number): string {
  if (s.length <= n) return s;
  return s.slice(0, n).trimEnd() + "…";
}
---

<h2 class="fold">Recent comments<span class="ct">{total}</span></h2>
{
  comments.length === 0 ? (
    <p class="on-counter">No comments yet.</p>
  ) : (
    comments.map((c) => (
      <div class="slip">
        <div class="tear-b">
          <div class="who">
            <Avatar seed={c.alias} />
            <b>{c.alias}</b>
            <span class={getModerationStampClass(c.moderationStatus)}>
              {getModerationLabel(c.moderationStatus)}
            </span>
            <i class="leader" />
            <time datetime={c.createdAt.toISOString()}>{formatRelative(c.createdAt)}</time>
          </div>
          <p class="msg">{truncate(c.message, 120)}</p>
          <p class="on">
            on{" "}
            <a href={`/admin/articles/${c.articleSlug}`}>
              {titleMap.get(c.articleSlug) ?? c.articleSlug}
            </a>
          </p>
        </div>
      </div>
    ))
  )
}
