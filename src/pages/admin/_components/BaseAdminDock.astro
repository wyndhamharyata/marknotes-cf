---
import Icon from "../../../components/Icon.astro";

type Props = {
  menus: Menu[];
  currentPath: string;
};

type Menu = {
  path: string;
  label: string;
};

const { menus, currentPath } = Astro.props;
---

<nav class="till dock" aria-label="Admin">
  <a href="/" hx-boost="false" class="key key-sq" aria-label="Back to the site">
    <Icon name="nota:back" />
  </a>
  {
    menus.map((menu) => (
      <a
        href={menu.path}
        hx-boost="false"
        class="key"
        aria-current={currentPath === menu.path ? "page" : undefined}
      >
        <span class="led" />
        {menu.label}
      </a>
    ))
  }
  <button class="key" type="button" id="night-key" aria-pressed="false">
    <span class="led"></span>Night
  </button>
</nav>
