---
import { getCollection } from "astro:content";
import { getDoStub } from "../../../lib/db/do-client";

const articles = await getCollection("blog");
const analyticsMap = await getDoStub().getLatestAnalyticsBySlugs(articles.map((a) => a.id));

const enriched = articles.map((a) => {
  const analytics = analyticsMap.get(a.id);
  return {
    slug: a.id,
    title: a.data.title,
    pubDate: a.data.pubDate,
    pageviews7d: analytics?.pageviews7d ?? 0,
    visits7d: analytics?.visits7d ?? 0,
  };
});

const top = enriched
  .filter((a) => a.pageviews7d > 0)
  .sort((a, b) => b.pageviews7d - a.pageviews7d);

const fmt = new Intl.NumberFormat();
---

<!-- Stretches to the foot of the column on desktop, level with the comments. -->
<section class="paper lg:flex lg:flex-1 lg:flex-col">
  <div class="receipt tear-b lg:flex lg:flex-1 lg:flex-col">
    <h2 class="fold">Top articles<span class="ct">7 days</span></h2>
    {
      top.length === 0 ? (
        <p class="plot-empty">No analytics yet.</p>
      ) : (
        // Desktop: the rows fill the paper and scroll in it. Absolute, so they never set its height.
        // The scroller reaches 16px into the paper's 18px padding: its 12px bar plus 4px clear of
        // the numbers, which keep ending on the rule's edge.
        <div class="relative lg:min-h-40 lg:flex-1">
          <div class="pane-scroll lg:absolute lg:inset-y-0 lg:left-0 lg:-right-4 lg:overflow-y-auto lg:pr-1">
            {top.map((a) => (
              <a class="top-row" href={`/admin/articles/${a.slug}`}>
                <b>{a.title}</b>
                <i class="leader" />
                <span class="d">
                  {fmt.format(a.pageviews7d)} · {fmt.format(a.visits7d)}
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
