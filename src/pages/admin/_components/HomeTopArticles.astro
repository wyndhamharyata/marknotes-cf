---
import { getCollection } from "astro:content";
import { getDoStub } from "../../../lib/db/do-client";

const articles = await getCollection("blog");
const analyticsMap = await getDoStub().getLatestAnalyticsBySlugs(articles.map((a) => a.id));

const enriched = articles.map((a) => {
  const analytics = analyticsMap.get(a.id);
  return {
    slug: a.id,
    title: a.data.title,
    pubDate: a.data.pubDate,
    pageviews7d: analytics?.pageviews7d ?? 0,
    visits7d: analytics?.visits7d ?? 0,
  };
});

const top = enriched
  .filter((a) => a.pageviews7d > 0)
  .sort((a, b) => b.pageviews7d - a.pageviews7d)
  .slice(0, 5);

const fmt = new Intl.NumberFormat();
---

<section class="paper">
  <div class="receipt tear-b">
    <h2 class="fold">Top articles<span class="ct">7 days</span></h2>
    {
      top.length === 0 ? (
        <p class="plot-empty">No analytics yet.</p>
      ) : (
        top.map((a) => (
          <a class="top-row" href={`/admin/articles/${a.slug}`}>
            <b>{a.title}</b>
            <i class="leader" />
            <span class="d">
              {fmt.format(a.pageviews7d)} · {fmt.format(a.visits7d)}
            </span>
          </a>
        ))
      )
    }
  </div>
</section>
