---
import { getCollection } from "astro:content";
import { getDoStub } from "../../../lib/db/do-client";

const stub = getDoStub();
const [articles, totals, counts] = await Promise.all([
  getCollection("blog"),
  stub.getSiteWideTotals(),
  stub.getCommentCounts(),
]);

const fmt = new Intl.NumberFormat();
const readouts = [
  ["Articles", articles.length],
  ["Pageviews 7d", totals.pageviews7d],
  ["Visits 7d", totals.visits7d],
  ["Comments", counts.all],
] as const;
---

<div class="till readouts">
  <i class="bolt l"></i><i class="bolt r"></i>
  {
    readouts.map(([label, value]) => (
      <div class="vfd">
        <span>{label}</span>
        <i class="vfd-leader" />
        <b>{fmt.format(value)}</b>
      </div>
    ))
  }
</div>
