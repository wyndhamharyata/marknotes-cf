---
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import BaseAdminLayout from "../../../layouts/BaseAdminLayout.astro";
import Icon from "../../../components/Icon.astro";
import FormattedDate from "../../articles/_components/FormattedDate.astro";
import CommentSection from "../../articles/_components/CommentSection.astro";
import ShopIsland from "../../articles/_components/ShopIsland.astro";
import Analytics from "./_components/Analytics.astro";
import { ADMIN_DOCK, ARTICLE_PROSE_CLASS } from "../../../consts";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return new Response("Not found", { status: 404 });

const post = await getEntry("blog", slug);
if (!post) return new Response("Not found", { status: 404 });

const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, coffeeId, rating } = post.data;
---

<BaseAdminLayout
  title={title}
  description={description}
  dockProp={{ menus: ADMIN_DOCK, currentPath: "/admin/articles" }}
>
  <div class="page-head">
    <a class="key" href="/admin/articles"><Icon name="nota:back" />Articles</a>
    <h1 class="sm">{title}</h1>
    <a class="key key-signal" href={`/admin/articles/${post.id}/edit`} hx-boost="false">Edit</a>
  </div>

  <div class="detail">
    <div class="views">
      <label class="key key-grow">
        <input type="radio" name="view" id="view-article" class="sr-only" checked />Article
      </label>
      <label class="key key-grow">
        <input type="radio" name="view" id="view-numbers" class="sr-only" />Numbers
      </label>
    </div>

    <div class="side-article">
      {/* The sheet readers get, without the counter around it. */}
      <article class="sheet article">
        {
          heroImage && (
            <div class="halftone hero">
              <Image
                loading="eager"
                width={Math.min(heroImage.width, 1400)}
                src={heroImage}
                alt=""
              />
            </div>
          )
        }
        <h2 class="h1">{title}</h2>
        <p class="dateline">
          {coffeeId && <span class="stamp">Coffee review</span>}
          <b><FormattedDate date={pubDate} /></b>
          {
            updatedDate && (
              <span>
                Updated <FormattedDate date={updatedDate} />
              </span>
            )
          }
        </p>
        {
          coffeeId && (
            <div class="contents">
              <ShopIsland server:defer coffeeId={coffeeId} rating={rating}>
                <div slot="fallback" class="tk-skel" />
              </ShopIsland>
            </div>
          )
        }
        <div class={ARTICLE_PROSE_CLASS}>
          <Content />
        </div>
      </article>

      {/* Own wrapper: see the note in BlogPost.astro. */}
      <div class="contents">
        <CommentSection server:defer articleSlug={post.id}>
          <section slot="fallback" class="comments">
            <h2 class="fold">Comments</h2>
          </section>
        </CommentSection>
      </div>
    </div>

    <div class="side-numbers">
      <Analytics slug={post.id} server:defer>
        <div slot="fallback" class="till readouts"><div class="vfd"></div></div>
      </Analytics>
    </div>
  </div>
</BaseAdminLayout>
