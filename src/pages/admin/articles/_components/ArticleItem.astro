---
import { Image } from "astro:assets";
import type { ArticleAnalyticsRow } from "../../../../lib/analytics/types";
import { getDoStub } from "../../../../lib/db/do-client";
import FormattedDate from "../../../articles/_components/FormattedDate.astro";
import { type CollectionEntry } from "astro:content";

type Props = {
  article: CollectionEntry<"blog">;
  /** Absent until the 3-hourly analytics cron has seen this slug. */
  analytic?: ArticleAnalyticsRow;
};

const prop: Props = Astro.props;
const { article, analytic } = prop;
const comments = await getDoStub().getCommentsBySlug(article.id);
const { heroImage, title, pubDate, coffeeId } = article.data;
---

<a href={`/admin/articles/${article.id}`} class="ledger-row" hx-boost="false">
  <span class="halftone thumb">
    {heroImage && <Image src={heroImage} width={144} alt="" />}
  </span>
  <span>
    <span class="nm">{title}</span>
    <span class="date">
      {coffeeId && <span class="stamp">Coffee review</span>}
      <FormattedDate date={pubDate} />
    </span>
  </span>
  <span class="num">{analytic?.pageviews7d ?? 0}</span>
  <span class="num">{comments.length}</span>
</a>
