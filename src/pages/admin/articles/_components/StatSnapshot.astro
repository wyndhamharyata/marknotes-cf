---
import { getDoStub } from "../../../../lib/db/do-client";

const { slug } = Astro.props;

const analytics = await getDoStub().getLatestAnalyticsBySlug(slug);
const readouts = [
  ["24 hours", analytics?.pageviews24h ?? 0],
  ["7 days", analytics?.pageviews7d ?? 0],
  ["30 days", analytics?.pageviews30d ?? 0],
] as const;
---

<div class="till readouts">
  <i class="bolt l"></i><i class="bolt r"></i>
  {
    readouts.map(([label, value]) => (
      <div class="vfd">
        <span>{label}</span>
        <i class="vfd-leader" />
        <b>{value}</b>
      </div>
    ))
  }
</div>
