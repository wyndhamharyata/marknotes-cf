---
import StatSnapshot from "./StatSnapshot.astro";
import PageviewsChart from "./PageviewsChart.tsx";
import WebVitalsChart, { VITALS } from "./WebVitalsChart.tsx";
import { getDoStub } from "../../../../lib/db/do-client";
import {
  hasAnyWebVitalSamples,
  toPageviewsSeries,
  toWebVitalRatioSeries,
} from "../../../../lib/analytics/transform";

const { slug } = Astro.props;

const sevenDaysAgoSec = Math.floor((Date.now() - 7 * 24 * 60 * 60 * 1000) / 1000);
const history = await getDoStub().getAnalyticsHistoryBySlug(slug, {
  sinceUnixSec: sevenDaysAgoSec,
});
const hasChartData = history.length >= 2;
const pv = hasChartData ? toPageviewsSeries(history) : null;
const vitals = hasChartData ? toWebVitalRatioSeries(history) : null;
const vitalsHaveSamples = vitals ? hasAnyWebVitalSamples(vitals) : false;
---

<StatSnapshot slug={slug} />

{history.length === 0 && <p class="on-counter">No analytics yet.</p>}

<section class="plot">
  <h2>Pageviews, 7-day rolling</h2>
  {
    hasChartData && pv ? (
      <PageviewsChart client:idle ts={pv.ts} pv7d={pv.pv7d} />
    ) : (
      <p class="plot-empty">The trend starts after two snapshots.</p>
    )
  }
</section>

<section class="plot">
  <h2>Web vitals, % good</h2>
  {
    hasChartData && vitals && vitalsHaveSamples ? (
      <>
        <span class="legend">
          {VITALS.map((v) => (
            <span>
              <i style={`background:${v.stroke}`} />
              {v.label}
            </span>
          ))}
        </span>
        <WebVitalsChart
          client:idle
          ts={vitals.ts}
          lcp={vitals.lcp}
          inp={vitals.inp}
          cls={vitals.cls}
          ttfb={vitals.ttfb}
        />
      </>
    ) : (
      <p class="plot-empty">No web vitals for this article yet.</p>
    )
  }
</section>
