---
import { getCollection } from "astro:content";
import BaseAdminLayout from "../../../../layouts/BaseAdminLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, ADMIN_DOCK, ARTICLE_PROSE_CLASS } from "../../../../consts";
import MdxEditor from "../_components/MdxEditor";

export const prerender = false;

// Rendered on the server so the editor can warn about a slug collision without
// a round trip; the same collection the article pages are built from.
const existingSlugs = (await getCollection("blog")).map((article) => article.id);
---

<BaseAdminLayout
  title={`New article — ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  dockProp={{ menus: ADMIN_DOCK, currentPath: "/admin/articles" }}
  maxWidthClass="max-w-[110rem]"
  mainPaddingClass="px-0 pb-28 md:px-4 md:py-8 md:pb-24"
>
  {
    /* `main` fills the viewport, so its content box is 100dvh less its own
      padding; flex distributes the rest. */
  }
  <div class="mx-auto mt-4 flex w-full flex-col md:mt-0 md:h-[calc(100dvh-8rem)]">
    <div class="breadcrumbs my-2 hidden w-fit px-4 py-2 text-sm md:block">
      <ul class="flex flex-wrap overflow-x-clip text-ellipsis">
        <li><a href="/admin/articles">Articles</a></li>
        <li>New</li>
      </ul>
    </div>

    <MdxEditor client:load existingSlugs={existingSlugs} proseClass={ARTICLE_PROSE_CLASS} />
  </div>
</BaseAdminLayout>
