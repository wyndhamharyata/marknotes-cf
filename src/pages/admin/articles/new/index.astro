---
import { getCollection } from "astro:content";
import BaseAdminLayout from "../../../../layouts/BaseAdminLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, ADMIN_DOCK, ARTICLE_PROSE_CLASS } from "../../../../consts";
import MdxEditor from "../_components/MdxEditor";
import { fetchShop } from "../../../../lib/kopimap";

export const prerender = false;

// Server-rendered so the editor can warn about a slug collision without a round trip.
const articles = await getCollection("blog");
const existingSlugs = articles.map((article) => article.id);
// petakopi's "Create Review Article" link; only uuid characters, so the value is safe to write into YAML.
const coffeeId = Astro.url.searchParams.get("coffeeId") ?? "";
const isUuid =
  coffeeId.length === 36 && [...coffeeId].every((c) => "0123456789abcdef-".includes(c));

// One review per shop: an existing one opens in the editor instead of a second draft.
const reviewed = isUuid && articles.find((article) => article.data.coffeeId === coffeeId);
if (reviewed) return Astro.redirect(`/admin/articles/${reviewed.id}/edit`);
const shop = isUuid ? ((await fetchShop(coffeeId)) ?? undefined) : undefined;
---

<BaseAdminLayout
  title={`New article — ${SITE_TITLE}`}
  description={SITE_DESCRIPTION}
  dockProp={{ menus: ADMIN_DOCK, currentPath: "/admin/articles" }}
>
  <MdxEditor
    client:load
    existingSlugs={existingSlugs}
    extraFrontmatter={isUuid ? [`coffeeId: "${coffeeId}"`] : []}
    shop={shop}
    proseClass={ARTICLE_PROSE_CLASS}
  />
</BaseAdminLayout>
