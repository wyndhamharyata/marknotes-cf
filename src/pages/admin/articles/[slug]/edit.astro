---
import { tryCatch } from "@maxmorozoff/try-catch-tuple";
import { getEntry } from "astro:content";
import BaseAdminLayout from "../../../../layouts/BaseAdminLayout.astro";
import { SITE_DESCRIPTION, ADMIN_DOCK, ARTICLE_PROSE_CLASS } from "../../../../consts";
import { isSafeAssetKey, isSafeSlug } from "../../../../lib/asset-key";
import { parseMdx } from "../../../../lib/editor/mdx-serialize";
import { repoAssetUrl } from "../../../../lib/editor/upload";
import { ghApi } from "../../../../lib/github";
import MdxEditor from "../_components/MdxEditor";
import { fetchShop } from "../../../../lib/kopimap";

export const prerender = false;

const { slug } = Astro.params;
if (!slug || !isSafeSlug(slug)) return new Response("Not found", { status: 404 });

// `main`, not the collection, which is stale until a deploy lands — writing it back reverts.
const [resp, fetchErr] = await tryCatch(
  ghApi(`/contents/src/content/blog/${slug}.mdx?ref=main`, {
    headers: { Accept: "application/vnd.github.raw" },
  })
);
if (fetchErr) return new Response(fetchErr.message, { status: 502 });

const [parsed, parseErr] = await tryCatch(resp.text().then(parseMdx));

const coffeeLine = parsed?.extraFrontmatter.find((line) => line.startsWith("coffeeId:"));
const shop = coffeeLine
  ? ((await fetchShop(JSON.parse(coffeeLine.slice("coffeeId:".length).trim()) as string)) ??
    undefined)
  : undefined;

const hero = parsed?.draft.heroPath;
const heroKey = hero?.startsWith("./") ? hero.slice(2) : "";
const heroPreviewUrl = isSafeAssetKey(heroKey)
  ? repoAssetUrl(heroKey)
  : // A legacy hero sits outside the asset namespace, so the collection's
    // processed URL is the only handle on it.
    (await getEntry("blog", slug))?.data.heroImage?.src;
---

<BaseAdminLayout
  title={`Edit ${parsed?.draft.title ?? slug}`}
  description={SITE_DESCRIPTION}
  dockProp={{ menus: ADMIN_DOCK, currentPath: "/admin/articles" }}
>
  {
    parseErr ? (
      <p class="err">
        {slug}.mdx cannot be opened in the editor:{" "}
        {parseErr instanceof Error ? parseErr.message : "unreadable"}
      </p>
    ) : (
      <MdxEditor
        client:load
        proseClass={ARTICLE_PROSE_CLASS}
        shop={shop}
        article={{
          slug,
          pubDate: parsed.pubDate,
          initial: parsed.draft,
          extraFrontmatter: parsed.extraFrontmatter,
          extraImports: parsed.extraImports,
          heroPreviewUrl,
        }}
      />
    )
  }
</BaseAdminLayout>
