---
export const prerender = false;

import BaseAdminLayout from "../../../layouts/BaseAdminLayout.astro";
import { SITE_DESCRIPTION, SITE_TITLE, ADMIN_DOCK } from "../../../consts";
import { getCollection } from "astro:content";
import ArticleItem from "./_components/ArticleItem.astro";
import { getDoStub } from "../../../lib/db/do-client";

const articles = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const analyticsMap = await getDoStub().getLatestAnalyticsBySlugs(articles.map((a) => a.id));
---

<BaseAdminLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  dockProp={{ menus: ADMIN_DOCK, currentPath: "/admin/articles" }}
>
  <div class="mx-auto flex flex-col py-4 md:w-3xl">
    <div class="mx-4 flex items-center justify-between md:mx-0">
      <h1 class="text-2xl font-bold">Articles</h1>
      {
        /* hx-boost swaps the body over AJAX, which is not a reliable way to get
          an Astro client island to hydrate. Force a real navigation. */
      }
      <a href="/admin/articles/new" class="btn btn-primary btn-sm" hx-boost="false">New article</a>
    </div>
    <div class="mt-4 md:mt-0">
      {
        articles.map((article) => (
          <ArticleItem article={article} analytic={analyticsMap.get(article.id)} />
        ))
      }
    </div>
  </div>
</BaseAdminLayout>
