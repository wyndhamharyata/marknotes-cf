---
import type { AdminComment } from "../../../../lib/comments/types";
import { getModerationLabel, getModerationStampClass } from "../../../../lib/comments/types";
import Avatar from "../../../articles/_components/comments/Avatar";

type Props = {
  comment: AdminComment;
};
const { comment } = Astro.props;
---

<details class="thread">
  <summary class="key key-sm">
    {comment.children.length}
    {comment.children.length === 1 ? "reply" : "replies"}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M5 9l7 7 7-7"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="square"></path>
    </svg>
  </summary>
  {
    comment.children.map((child) => (
      <div class="thread-row">
        <Avatar seed={child.alias} />
        <div class="min-w-0">
          <b>{child.alias}</b>{" "}
          <span class={getModerationStampClass(child.moderationStatus)}>
            {getModerationLabel(child.moderationStatus)}
          </span>
          <p class="m-0">{child.message}</p>
        </div>
      </div>
    ))
  }
</details>
