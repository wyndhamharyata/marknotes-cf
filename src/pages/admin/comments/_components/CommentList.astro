---
import { getCollection } from "astro:content";
import { getDoStub } from "../../../../lib/db/do-client";
import { type ModerationStatusType } from "../../../../lib/comments/types";
import CommentModerationItem from "./CommentModerationItem.astro";
import Pagination from "./Pagination.astro";

type Props = {
  filterStatus: ModerationStatusType | null;
  currentPage: number;
  limit: number;
  baseUrl: string;
};

const { filterStatus, currentPage, limit, baseUrl } = Astro.props;

const [{ comments, total }, articles] = await Promise.all([
  getDoStub().getCommentsForAdmin({ status: filterStatus, page: currentPage, limit }),
  getCollection("blog"),
]);

const totalPages = Math.ceil(total / limit);
const articleTitleMap = new Map(articles.map((a) => [a.id, a.data.title]));

const enrichedComments = comments.map((c) => ({
  ...c,
  articleTitle: articleTitleMap.get(c.articleSlug) || c.articleSlug,
}));
---

<div id="comment-list">
  {enrichedComments.length === 0 && <p class="on-counter">No comments found.</p>}
  {enrichedComments.map((comment) => <CommentModerationItem comment={comment} />)}
</div>

{
  totalPages > 1 && (
    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={baseUrl} />
  )
}
