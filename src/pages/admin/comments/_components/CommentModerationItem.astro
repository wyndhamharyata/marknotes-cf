---
import {
  ModerationStatus,
  getModerationLabel,
  getModerationStampClass,
  type AdminComment,
} from "../../../../lib/comments/types";
import { formatDate } from "../../../../lib/date";
import Avatar from "../../../articles/_components/comments/Avatar";
import ModerationReason from "./ModerationReason.astro";
import CommentReplies from "./CommentReplies.astro";

type Props = {
  comment: AdminComment;
};

const { comment } = Astro.props;
---

<div class="slip">
  <div class="tear-b">
    {
      comment.parent && (
        <p class="parent-ctx">
          Replying to <b>{comment.parent.alias}</b>: {comment.parent.message}
        </p>
      )
    }
    <div class="who">
      <Avatar seed={comment.alias} />
      <b>{comment.alias}</b>
      <span class={getModerationStampClass(comment.moderationStatus)}>
        {getModerationLabel(comment.moderationStatus)}
      </span>
      <i class="leader"></i>
      <time datetime={comment.createdAt.toISOString()}>{formatDate(comment.createdAt)}</time>
    </div>
    <p class="msg">{comment.message}</p>
    <ModerationReason comment={comment} />
    <p class="on">
      on <a href={`/admin/articles/${comment.articleSlug}`}>{comment.articleTitle}</a>
    </p>
    {comment.children.length > 0 && <CommentReplies comment={comment} />}
    <!-- The endpoints redirect to the list, which replaces the page, not the button. -->
    <div class="acts" hx-target="body">
      {
        comment.moderationStatus !== ModerationStatus.OK && (
          <button
            class="key key-sm key-signal"
            hx-post={`/api/admin/comments/${comment.id}/approve`}
            hx-confirm="Approve this comment?"
          >
            Approve
          </button>
        )
      }
      <button
        class="key key-sm"
        hx-post={`/api/admin/comments/${comment.id}/hide`}
        hx-confirm="Hide this comment?"
      >
        Hide
      </button>
    </div>
  </div>
</div>
