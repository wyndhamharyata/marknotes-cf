---
import Icon from "../../components/Icon.astro";

const today = new Date();
const profiles = [
  { href: "https://twitter.com/muhwyndham", label: "Twitter", icon: "simple-icons:x" },
  {
    href: "https://www.youtube.com/channel/UCPmxWqF9kzhe-VrOylqH2AA",
    label: "YouTube",
    icon: "simple-icons:youtube",
  },
  { href: "https://github.com/wyndhamharyata", label: "GitHub", icon: "simple-icons:github" },
  { href: "https://mwyndham.medium.com", label: "Medium", icon: "simple-icons:medium" },
  {
    href: "https://www.linkedin.com/in/mwyndham",
    label: "LinkedIn",
    icon: "simple-icons:linkedin",
  },
];
---

<footer class="till colophon">
  <i class="bolt l"></i><i class="bolt r"></i>
  <span class="engr">Marknotes by Wyndham · © {today.getFullYear()} · All rights reserved</span>
  {
    profiles.map(({ href, label, icon }) => (
      <a class="key key-sq" href={href} aria-label={label}>
        <Icon name={icon} />
      </a>
    ))
  }
  <a class="key key-sq rss" href="/rss.xml" hx-boost="false" aria-label="RSS feed">RSS</a>
  <button class="key key-sq" type="button" id="night-key" aria-label="Night" aria-pressed="false">
    <Icon name="heroicons:moon" />
  </button>
  <a class="key" href="/admin" hx-boost="false">Admin</a>
</footer>

<script>
  import "../../scripts/theme";
</script>
