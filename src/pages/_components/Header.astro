---
import Icon from "../../components/Icon.astro";

const RESUME = "/articles/m-wyndham-haryata-permana-sr-full-stack-engineer";
const path = Astro.url.pathname.replace(/\/+$/, "");
// The till latches the section, so an article keeps Blog down.
const section =
  path === RESUME ? "Resume" : path.startsWith("/articles") ? "Blog" : path === "" ? "Home" : null;
const current = (name: string) => (section === name ? "page" : undefined);
---

<nav class="till top-till" aria-label="Site">
  <i class="bolt l"></i><i class="bolt r"></i>
  <div class="till-keys">
    <a class="key" href="/" aria-current={current("Home")}><span class="led"></span>Home</a>
    <a class="key" href="/articles/" aria-current={current("Blog")}><span class="led"></span>Blog</a
    >
    <a class="key" href="https://kopimap.mwyndham.dev" hx-boost="false"
      ><span class="led"></span>Kopimap<Icon name="nota:out" class="out" /></a
    >
    <a class="key" href={RESUME} aria-current={current("Resume")}><span class="led"></span>Resume</a
    >
  </div>
  <div class="till-slot"></div>
</nav>
