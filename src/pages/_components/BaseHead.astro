---
import "../../styles/global.css";
import type { ImageMetadata } from "astro";
// The homepage in light mode, 1200x630: the share card for pages without a hero.
import FallbackImage from "../../assets/og-default.jpg";
import { SITE_TITLE } from "../../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<script is:inline>
  (function () {
    try {
      var root = document.documentElement;
      var theme = localStorage.getItem("theme");
      var old = localStorage.getItem("dark-mode");
      // The old on/off night switch was today's dim.
      if (theme === null && old !== null) {
        theme = old === "true" ? "dim" : "light";
        localStorage.setItem("theme", theme);
        localStorage.removeItem("dark-mode");
      }
      theme = theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      root.classList.add("js");
      if (theme !== "light") root.classList.add("dark");
      if (theme === "dark") root.classList.add("black");
    } catch (e) {}
  })();
</script>

<!-- Only the body face is worth preloading: the rest queue behind the stylesheet. -->
<link
  rel="preload"
  href="/fonts/atkinson-next-core.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<script>
  import "htmx.org";
  import "htmx-ext-head-support";
</script>

<script>
  function setDynamicFavicon() {
    const existingLink = document.querySelector('link[rel="icon"]');

    // @ts-expect-error href exists
    if (existingLink?.href.includes("/api/favicon.svg")) {
      return;
    }

    existingLink?.remove();

    // Session-based cache buster - stays same for session, fresh on new visits
    const sessionId = sessionStorage.getItem("favicon-session") || Date.now().toString();
    sessionStorage.setItem("favicon-session", sessionId);

    const newLink = document.createElement("link");
    newLink.rel = "icon";
    newLink.type = "image/svg+xml"; // Dynamic favicon is still SVG (adorable)
    newLink.href = `/api/favicon.svg?v=${sessionId}`;
    document.head.appendChild(newLink);
  }
  setDynamicFavicon();
  document.addEventListener("htmx:afterSettle", setDynamicFavicon);
</script>
