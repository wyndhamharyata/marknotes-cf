---
import { tryCatch } from "@maxmorozoff/try-catch-tuple";
import { getDoStub } from "../../../lib/db/do-client";
import { buildCommentTree } from "../../../lib/comments/tree";
import { getOrCreateAlias } from "../../../lib/comments/diceware";
import { isAdminRequest } from "../../../lib/auth";
import { AUTHOR_ALIAS } from "../../../lib/comments/author";
import CommentTree from "./comments/CommentTree";

interface Props {
  articleSlug: string;
}

const { articleSlug } = Astro.props;

const [data, loadErr] = await tryCatch(async () => {
  // getOrCreateAlias sets the cookie when the visitor has none yet.
  const alias = (await isAdminRequest(Astro.cookies))
    ? AUTHOR_ALIAS
    : getOrCreateAlias(Astro.cookies);
  const comments = await getDoStub().getCommentsBySlug(articleSlug);

  // Serialize dates to ISO strings for Preact
  const serializedTree = JSON.parse(JSON.stringify(buildCommentTree(comments)));
  return { alias, serializedTree };
});
if (loadErr) console.error("CommentSection error:", loadErr.message);

const alias = data?.alias ?? "anonymous";
const serializedTree = data?.serializedTree ?? [];
const error = loadErr ? loadErr.message : null;
---

<section id="comments" class="comments">
  {
    error ? (
      <>
        <h2 class="fold">Comments</h2>
        <p class="err">Failed to load comments: {error}</p>
      </>
    ) : (
      <CommentTree
        client:load
        comments={serializedTree}
        articleSlug={articleSlug}
        userAlias={alias}
      />
    )
  }
</section>
