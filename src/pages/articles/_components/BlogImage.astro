---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
  loading?: "lazy" | "eager" | null | undefined;
}

const { src, alt, width, height, caption, loading = "lazy" } = Astro.props;

// Width cap only: a fixed height would squash these into the remote default's 4:3 box.
const MAX_IMPORTED_WIDTH = 1200;
const imported = typeof src === "string" ? null : src;
---

<figure class="my-6">
  {
    imported ? (
      <Image
        src={imported}
        alt={alt}
        width={width ?? Math.min(imported.width, MAX_IMPORTED_WIDTH)}
        class="mx-auto max-w-full rounded-lg shadow-md"
        loading={loading}
      />
    ) : (
      <Image
        src={src as string}
        alt={alt}
        width={width ?? 800}
        height={height ?? 600}
        class="mx-auto max-w-full rounded-lg shadow-md"
        loading={loading}
      />
    )
  }
  {
    caption && (
      <figcaption class="text-base-content/70 mt-2 text-center text-sm italic">
        {caption}
      </figcaption>
    )
  }
</figure>
