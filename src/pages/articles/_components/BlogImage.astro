---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
  loading?: "lazy" | "eager" | null | undefined;
}

const { src, alt, width, height, caption, loading = "lazy" } = Astro.props;

// Width cap only: a fixed height would squash these into the remote default's 4:3 box.
const MAX_IMPORTED_WIDTH = 1200;
const imported = typeof src === "string" ? null : src;
---

<figure class="photo-fig not-prose">
  <div class="photo">
    {
      imported ? (
        <Image
          src={imported}
          alt={alt}
          width={width ?? Math.min(imported.width, MAX_IMPORTED_WIDTH)}
          loading={loading}
        />
      ) : (
        <Image
          src={src as string}
          alt={alt}
          width={width ?? 800}
          height={height ?? 600}
          loading={loading}
        />
      )
    }
    <i class="pc"></i><i class="pc"></i><i class="pc"></i><i class="pc"></i>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
