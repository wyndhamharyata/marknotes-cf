---
import BaseHead from "../pages/_components/BaseHead.astro";
import Header from "../pages/_components/Header.astro";
import Footer from "../pages/_components/Footer.astro";
import NotaFilters from "../components/NotaFilters.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="font-atkinson flex min-h-screen flex-col" hx-boost="true" hx-ext="head-support">
    <NotaFilters />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <div id="htmx-indicator" class="htmx-indicator fixed top-0 right-0 left-0 z-50 h-[3px]">
      <div class="h-full" style="background:var(--ink)"></div>
    </div>

    <script>
      // Prints raster in as they scroll into view; the CSS only animates on desktop.
      function printIn() {
        const observer = new IntersectionObserver((entries) => {
          let i = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const print = entry.target as HTMLElement;
            print.style.setProperty("--d", `${i++ * 24}ms`);
            print.classList.add("in");
            observer.unobserve(print);
          }
        });
        document
          .querySelectorAll("[data-print] .halftone:not(.in)")
          .forEach((print) => observer.observe(print));
      }
      printIn();
      document.addEventListener("htmx:afterSettle", printIn);
    </script>
  </body>
</html>
