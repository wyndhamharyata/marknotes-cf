---
import BaseHead from "../pages/_components/BaseHead.astro";
import BaseAdminDock from "../pages/admin/_components/BaseAdminDock.astro";
import DeployBanner from "../pages/admin/_components/DeployBanner";
import NotaFilters from "../components/NotaFilters.astro";
import type { ImageMetadata } from "astro";
import type { ComponentProps } from "astro/types";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  dockProp: ComponentProps<typeof BaseAdminDock>;
  /** "narrow" and "mid" for single-column pages. */
  width?: "narrow" | "mid";
}

const { title, description, image, dockProp, width } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="font-atkinson flex min-h-screen flex-col" hx-boost="true" hx-ext="head-support">
    <NotaFilters />
    <main id="main-content" class:list={["admin-main flex-1", width]}>
      <slot />
    </main>

    <BaseAdminDock menus={dockProp.menus} currentPath={dockProp.currentPath} />
    {/* Fixed, so a deploy in flight never shifts a page that owns its height. */}
    <DeployBanner client:idle />
    <div id="htmx-indicator" class="htmx-indicator fixed top-0 right-0 left-0 z-50 h-[3px]">
      <div class="h-full" style="background:var(--ink)"></div>
    </div>

    <script>
      import "../scripts/theme";
    </script>
    <script is:inline>
      // The dock floats over the page, so the page reserves room for it only once the content
      // is long enough to scroll under it; otherwise that reserve is a scrollbar to nowhere.
      (function () {
        function fit() {
          var main = document.querySelector(".admin-main");
          var dock = document.querySelector(".dock");
          if (!main || !dock) return;
          // Measure with the reserve off, then keep it only if the page still overflows.
          main.style.paddingBottom = "0px";
          main.style.paddingBottom =
            document.documentElement.scrollHeight > window.innerHeight
              ? dock.offsetHeight + 24 + "px"
              : "0px";
        }
        fit();
        window.addEventListener("load", fit);
        window.addEventListener("resize", fit);
        document.addEventListener("htmx:afterSettle", fit);
      })();
    </script>
  </body>
</html>
