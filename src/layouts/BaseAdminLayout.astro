---
import BaseHead from "../pages/_components/BaseHead.astro";
import BaseAdminDock from "../pages/admin/_components/BaseAdminDock.astro";
import type { ImageMetadata } from "astro";
import type { ComponentProps } from "astro/types";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  dockProp: ComponentProps<typeof BaseAdminDock>;
  maxWidthClass?: string;
  /**
   * The default reserves room for the fixed dock and its gradient. Full-height
   * pages need that back and manage the clearance themselves.
   */
  mainPaddingClass?: string;
}

const {
  title,
  description,
  image,
  dockProp,
  maxWidthClass = "max-w-4xl",
  mainPaddingClass = "px-0 pb-40 md:px-4 md:py-8 md:pb-40",
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="font-sono flex min-h-screen flex-col" hx-boost="true" hx-ext="head-support">
    {/* Background layer */}
    <div class="bg-base-200 dark:bg-base-300 fixed inset-0 -z-10">
      <div class="grid-bg absolute inset-0"></div>
      <div class="from-secondary/5 via-accent/5 absolute inset-0 bg-gradient-to-bl to-transparent">
      </div>
    </div>

    <main id="main-content" class={`mx-auto w-full ${maxWidthClass} flex-1 ${mainPaddingClass}`}>
      <slot />
    </main>

    <BaseAdminDock menus={dockProp.menus} currentPath={dockProp.currentPath} />
    {/* Loading indicator */}
    <div id="htmx-indicator" class="htmx-indicator fixed top-0 right-0 left-0 z-50 h-1">
      <div class="bg-primary h-full"></div>
    </div>

    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
